{
  "$schema": "https://typedoc.org/schema.json",
  "name": "AnixartJS",
  "entryPoints": [
    "../src/index.ts",
    "../src/core/endpoints.ts",
    "../src/core/anixartClient.ts",
    "../src/core/http/httpTypes.ts",
    "../src/core/http/httpClient.ts",
    "../src/api/**/*.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "out": "reference/generated",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme"
  ],
  "readme": "none",
  "entryFileName": "index.md",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "docsRoot": ".",
  "disableSources": true,
